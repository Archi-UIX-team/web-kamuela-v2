{
  "name": "Kamuela Villas",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Kamuela Villas preview",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "bash -lc 'nohup python3 -m http.server 8000 --bind 0.0.0.0 > /tmp/kamuela-preview.log 2>&1 &'"
}